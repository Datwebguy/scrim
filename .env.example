# ── Required ────────────────────────────────────────────────────────────────
# Postgres. Local default: postgres://scrim:scrim@localhost:5432/scrim
DATABASE_URL=postgres://scrim:scrim@localhost:5432/scrim

# Two secrets. Generate them with:  npm run keys
SCRIM_SECRET_KEY=
SCRIM_PROOF_KEY=

# ── Turns on moving private money (mainnet) ─────────────────────────────────
# Free partner key from https://partners.near-intents.org
# Without it, people can still sign in and see their private balance.
ONECLICK_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Networks people can choose. Default: both. NEAR Intents exists on mainnet only,
# so private money (add, swap, links, proofs) is mainnet; testnet covers sign-in,
# team approvals, spending limits and real NEAR transfers.
# SCRIM_NETWORKS=mainnet,testnet
# Message recipient used when team members approve a payment. Use your site's host in production.
SCRIM_AUTH_RECIPIENT=scrim.local
# Override service addresses (defaults are the public services)
# ONECLICK_URL=https://1click.chaindefuser.com
# BRIDGE_RPC_URL=https://bridge.chaindefuser.com/rpc
# COINGECKO_URL=https://api.coingecko.com/api/v3
# NEAR_RPC_URL_MAINNET=
# NEAR_RPC_URL_TESTNET=
# NEAR_INDEXER_URL_MAINNET=
# NEAR_INDEXER_URL_TESTNET=

# ── Telegram alerts (optional) ──────────────────────────────────────────────
# Create a bot with @BotFather in Telegram, then set both. Approvers connect from the Team screen.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Public address of this site (used in alerts). On Vercel it is detected automatically.
# SCRIM_SITE_URL=https://scrim-alpha.vercel.app

# Ask your money: private answers from NEAR AI Cloud (https://cloud.near.ai). Optional model override.
NEARAI_API_KEY=
# NEARAI_MODEL=z-ai/glm-5.3-flash
