# Postgres connection. Local default: postgres://scrim:scrim@localhost:5432/scrim
DATABASE_URL=postgres://scrim:scrim@localhost:5432/scrim

# NEAR network used for wallet sign-in and access-key verification: testnet | mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Optional RPC override. Defaults to FastNEAR for the selected network.
NEAR_RPC_URL=

# NEP-413 recipient bound into every signed Scrim message. Use your production host.
SCRIM_AUTH_RECIPIENT=scrim.local

# Optional 1Click API key. When set, settlement quotes request the confidential path.
ONECLICK_JWT=
